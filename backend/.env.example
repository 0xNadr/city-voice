# CityVoice Backend Configuration

# ElevenLabs API Key (required for setup_agent.py)
ELEVENLABS_API_KEY=sk_your_api_key_here

# ElevenLabs Agent ID (set automatically by setup_agent.py)
# ELEVENLABS_AGENT_ID=agent_...

# Webhook base URL (set by setup_agent.py --update-webhooks)
# WEBHOOK_BASE_URL=https://your-tunnel-url.com

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_data

# Data paths
OPENING_HOURS_PATH=./data/opening_hours.json
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# Debug mode
DEBUG=true
