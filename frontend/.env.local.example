# CityVoice Frontend Configuration

# ElevenLabs Conversational Agent ID (REQUIRED)
# This is set automatically by: python scripts/setup_agent.py
# Or create manually at: https://elevenlabs.io/conversational-ai
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Backend API URL (for fetching opening hours display)
NEXT_PUBLIC_API_URL=http://localhost:8000
